# 示例：在腾讯云 CVM 上配合 fmz-ai-agent 使用 Gemini
# 用法（需 root）：
#   sudo cp deploy/fmz-ai-agent.tencent.example.env /etc/fmz-ai-agent.env
#   sudo chmod 600 /etc/fmz-ai-agent.env
#   sudo nano /etc/fmz-ai-agent.env   # 填入真实 API Key；代理端口按你本机 Clash/sing-box 等为准
#   sudo systemctl daemon-reload && sudo systemctl restart fmz-ai-agent
#
# 前提：同一台机器上已有 HTTP/SOCKS 代理监听 127.0.0.1（例如 Mixed 7890），且出站可访问 Google API。
# 详见仓库 server/local-ai-agent.env.example 中「腾讯云 / Linux」说明。

GEMINI_API_KEY=
FMZ_AI_AGENT_LOCAL_PROXY=http://127.0.0.1:7890
# 若不用 FMZ_AI_AGENT_LOCAL_PROXY，可改用下面两行（二选一即可）：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
