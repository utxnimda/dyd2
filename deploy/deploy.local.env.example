# 本机部署/SSH 配置（每机不同）
#
# 复制为同目录下的 deploy.local.env（已在仓库 .gitignore，勿提交）
# copy deploy\deploy.local.env.example deploy\deploy.local.env
#
# 用法：在仓库根目录 PowerShell 中执行：
#   . ./deploy/load-deploy-env.ps1
# 之后会设置进程级环境变量，供本节文档中的 ssh / scp 示例使用。
#
# 首次：
#   copy deploy\deploy.local.env.example deploy\deploy.local.env
# 再编辑 deploy.local.env，至少填写 FMZ_DEPLOY_SSH_KEY。

# 示例（本机默认 deploy.mjs 使用 D:\nimda1.pem，可按需覆盖）
FMZ_DEPLOY_SSH_KEY=D:/nimda1.pem
FMZ_DEPLOY_SSH_USER=root
FMZ_DEPLOY_SSH_HOST=118.195.150.4
FMZ_DEPLOY_WEB_ROOT=/var/www/fmz-dashboard/

# 仅部署静态：不向 /opt 同步后端、不 systemctl restart（默认不设）
# FMZ_DEPLOY_SKIP_BACKEND=1

# 将 release/config/nginx 同步到远端并 nginx -t && reload（默认不设；会覆盖 conf.d 同名文件）
# FMZ_DEPLOY_SYNC_NGINX=1
# FMZ_DEPLOY_NGINX_CONF_D=/etc/nginx/conf.d
