[Unit]
Description=FMZ AI Agent proxy server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fmz-ai-agent-server
ExecStart=/usr/bin/node /opt/fmz-ai-agent-server/ai-agent-server.mjs
Restart=always
RestartSec=5
Environment=AI_AGENT_PORT=8792
Environment=FMZ_SERVICE_BIND_HOST=0.0.0.0
Environment=NODE_ENV=production
# API Key、代理、远端共享密钥：/etc/fmz-ai-gateway.env（见 deploy/fmz-ai-gateway.env.example）
EnvironmentFile=-/etc/fmz-ai-gateway.env
# 兼容旧路径（仅密钥时仍可用）
EnvironmentFile=-/etc/fmz-ai-agent.env

[Install]
WantedBy=multi-user.target
