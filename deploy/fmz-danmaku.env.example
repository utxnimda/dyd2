# 复制到 CVM：/opt/fmz-danmaku-server/danmaku.env
# systemd 单元需包含：EnvironmentFile=-/opt/fmz-danmaku-server/danmaku.env
# （见 deploy/RELEASE_AND_DEPLOY.md §13.2）
#
# --- 仅宝宝巴士（窃听宝语关闭、dreamBus 开启时 pack 会自动生成 config/danmaku.env）---
# FMZ_DANMAKU_MODE=dream-bus-only
# FMZ_DREAM_BUS_ROOM_ID=9046690
#
# 日报/周报终稿或分段预摘要因「上下文过长」失败时，自动收窄分块并重试的次数上限（默认 4，含首次）
FMZ_AI_REPORT_CONTEXT_RETRY_MAX=4

# 以下为「热门直播间 / 终稿 user 过长」的再收窄档（上一档基础上的「收一档」）。

# 单次预摘要每段最大弹幕行数（略大 → 分段更少 → 终稿里「分段要点」总长短一些）
FMZ_AI_REPORT_CHUNK_DM_LINES=2400

# 终稿里礼物明细行上限（再降一档）
FMZ_AI_REPORT_MAX_GIFT_LINES=340

# 多段模式下并入终稿的原文抽样行数（再降一档，代码下限 40）
FMZ_AI_REPORT_VERBATIM_DM_SAMPLE=60

# 日报极重时强制拆段的最少段数（已为 2，不宜再低）
FMZ_AI_REPORT_DAILY_FORCE_MIN_PARTS=2
