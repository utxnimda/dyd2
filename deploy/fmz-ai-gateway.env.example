# AI 网关机（43.160.205.247）与主站调用方共用
# 用法（需 root）：
#   sudo cp deploy/fmz-ai-gateway.env.example /etc/fmz-ai-gateway.env
#   sudo chmod 600 /etc/fmz-ai-gateway.env
#   sudo nano /etc/fmz-ai-gateway.env
#   sudo systemctl restart fmz-ai-agent fmz-voice-clone
#
# 主站还需：相同 FMZ_REMOTE_SERVICE_SECRET 写入
#   /opt/fmz-danmaku-server/danmaku.env
#   /etc/nginx/conf.d/fmz-remote-secret.inc（由 npm run deploy + FMZ_DEPLOY_SYNC_NGINX=1 生成）

# 与主站 Nginx / 弹幕服务一致的共享密钥（必填，监听 0.0.0.0 时）
FMZ_REMOTE_SERVICE_SECRET=

# --- 出站 API（腾讯云机常见：本机 Clash Mixed 7890）---
GEMINI_API_KEY=
FMZ_AI_AGENT_LOCAL_PROXY=http://127.0.0.1:7890
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# Fish Audio（幻化宝音 / voice-clone-server 云端 TTS，必须写在网关机）
FISH_AUDIO_API_KEY=
