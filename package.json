{
  "name": "fmz-dashboard",
  "private": true,
  "version": "1.1.29",
  "fmzReleaseLabel": "v1.1.29",
  "fmzFeatures": {
    "sanguo": true,
    "sanguoUi": false,
    "baobao": true,
    "audio": true,
    "audioPlugin": false,
    "battle": false,
    "treasury": false,
    "preliminary": false,
    "users": false,
    "quota": false,
    "crimes": true,
    "douyuDanmaku": true,
    "aiAgent": true
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "reactions-server": "npm run start --prefix server",
    "defense-tower-server": "node server/defense-tower-server.mjs",
    "audio-server": "node server/audio-extractor-server.mjs",
    "crimes-server": "node server/crimes-server.mjs",
    "danmaku-server": "node server/douyu-danmaku-server.mjs",
    "ai-agent-server": "node server/ai-agent-server.mjs",
    "quota-server": "node server/quota-server.cjs",
    "check:reactions": "node scripts/check-reactions.mjs",
    "pack": "node scripts/bump-patch.mjs && vite build && node scripts/pack-release.mjs",
    "deploy": "node scripts/deploy.mjs",
    "pack:quota": "node scripts/pack-quota.mjs",
    "preview": "vite preview",
    "preview:public": "vite preview --host 0.0.0.0 --port 4173",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "md5": "^2.3.0",
    "phantomjs-prebuilt": "^2.1.16",
    "undici": "^8.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/md5": "^2.3.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
